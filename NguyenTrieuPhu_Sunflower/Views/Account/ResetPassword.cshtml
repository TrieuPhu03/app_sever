@model NguyenTrieuPhu_Sunflower.Models.ResetPasswordModel

@{
    ViewData["Title"] = "Reset Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div style="min-height: 100vh; background-color: #f3f4f6; display: flex; align-items: center; justify-content: center; padding: 3rem 1rem;">
   <div style="max-width: 28rem; width: 100%; background-color: white; border-radius: 0.5rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); padding: 2rem;">
       <h2 style="text-align: center; font-size: 1.875rem; font-weight: bold; color: #1f2937; margin-bottom: 2rem;">Reset Password</h2>
       
       <form asp-action="ResetPassword" asp-route-token="@Context.Request.Query["token"]" asp-route-email="@Context.Request.Query["email"]" method="post">
           @Html.AntiForgeryToken()

           <div style="margin-bottom: 1.5rem;">
               <label asp-for="NewPassword" style="display: block; font-size: 0.875rem; font-weight: 500; color: #374151;"></label>
               <input asp-for="NewPassword" name="NewPassword" type="password" style="width: 100%; padding: 0.5rem 0.75rem; margin-top: 0.25rem; border: 1px solid #d1d5db; border-radius: 0.375rem; box-shadow: 0 1px 2px 0 rgba(0,0,0,0.05);" />
               <span asp-validation-for="NewPassword" style="font-size: 0.875rem; color: #dc2626;"></span>
           </div>

           <div style="margin-bottom: 1.5rem;">
               <label asp-for="ConfirmPassword" style="display: block; font-size: 0.875rem; font-weight: 500; color: #374151;"></label>
               <input asp-for="ConfirmPassword" name="ConfirmPassword" type="password" style="width: 100%; padding: 0.5rem 0.75rem; margin-top: 0.25rem; border: 1px solid #d1d5db; border-radius: 0.375rem; box-shadow: 0 1px 2px 0 rgba(0,0,0,0.05);" />
               <span asp-validation-for="ConfirmPassword" style="font-size: 0.875rem; color: #dc2626;"></span>
           </div>

           <button type="submit" style="width: 100%; background-color: #4f46e5; color: white; padding: 0.5rem 1rem; border-radius: 0.375rem; font-weight: 500; font-size: 0.875rem; cursor: pointer; border: none; box-shadow: 0 1px 2px 0 rgba(0,0,0,0.05);">
               Đặt lại mật khẩu
           </button>
       </form>
   </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
